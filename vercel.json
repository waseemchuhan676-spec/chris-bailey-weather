{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/lexington-weather", "destination": "/lexington-weather.html" },
    { "source": "/louisville-weather", "destination": "/louisville-weather.html" },
    { "source": "/bowling-green-weather", "destination": "/bowling-green-weather.html" },
    { "source": "/covington-weather", "destination": "/covington-weather.html" },
    { "source": "/kentucky-weather", "destination": "/kentucky-weather.html" },
    { "source": "/radar", "destination": "/radar.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/tools", "destination": "/tools.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ]
}
